# Maintainer: XOMAK2245
pkgname=steam-card-xmk-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Cross-platform automated Steam trading card phantom farmer"
arch=('x86_64')
url="https://github.com/XOMAK2245/steam-card-xmk"
license=('MIT')
depends=('glibc')
optdepends=('steam: local Steam client needed for farming')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/steam-card-xmk-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    # Single self-contained binary: the Steamworks worker is embedded in it.
    install -Dm755 "$srcdir/steam-card-xmk-linux-x86_64/steam-card-xmk" "$pkgdir/usr/bin/steam-card-xmk"
    install -Dm644 "$srcdir/steam-card-xmk-linux-x86_64/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
